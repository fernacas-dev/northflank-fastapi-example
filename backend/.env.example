# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# CORS Configuration (separate multiple origins with commas)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Or use '*' to allow all origins
# CORS_ORIGINS=*

# Additional CORS settings (optional)
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
